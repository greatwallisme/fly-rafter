#!/usr/bin/env python3
"""Extract prompt constants from the dsh sources into fr-system-prompt.

PRD 22: every prompt constant is script-extracted from the deepseek-harness
sources; hand-copying is forbidden. The harness identity sentence alone is
brand-mapped (DeepSeek Harness -> Fly Rafter, PRD 10); every other constant
is verbatim.

Usage:
    FR_DSH_SOURCE=<dsh checkout> scripts/extract-prompts          # regenerate
    FR_DSH_SOURCE=<dsh checkout> scripts/extract-prompts --check  # diff only

Outputs (both regenerated together):
    crates/fr-system-prompt/src/prompts.rs  text constants
    crates/fr-system-prompt/src/orders.rs   SECTION_ORDERS / CONTEXT_ORDERS
"""

import difflib
import os
import re
import subprocess
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT_PROMPTS = os.path.join(REPO_ROOT, "crates", "fr-system-prompt", "src", "prompts.rs")
OUT_ORDERS = os.path.join(REPO_ROOT, "crates", "fr-system-prompt", "src", "orders.rs")

SYSTEM_PROMPT_TS = os.path.join("packages", "core", "system-prompt", "src", "index.ts")
RENDER_TS = os.path.join("packages", "context", "agent-instructions", "src", "render.ts")
BASE_PATCH = os.path.join("packages", "bundle", "base", "cordis.patch.yml")

HEADER = """\
//! Generated prompt constants; do not edit.
//!
//! @generated by scripts/extract-prompts from the deepseek-harness sources
//! (FR_DSH_SOURCE). DO NOT EDIT: rerun
//! `FR_DSH_SOURCE=<dsh checkout> scripts/extract-prompts`.
//! PRD 10: the harness identity sentence alone is brand-mapped
//! (DeepSeek Harness -> Fly Rafter); every other constant is verbatim.
//! Template constants carry `{{snake}}` placeholders ready for `format!`;
//! literal braces outside placeholders are doubled by the generator.

#![allow(
    clippy::doc_markdown,
    reason = "generated provenance comments quote wire names verbatim"
)]\
"""

# `${expr}` text inside an extracted template literal -> placeholder name.
PLACEHOLDERS = {
    "file.displayPath": "display_path",
    "file.content": "content",
    "change.path": "path",
    "scope": "scope",
    "body": "body",
    "maxBytes": "max_bytes",
    "parts.join('; ')": "parts",
    "omitted.map(file => file.displayPath).join(', ')": "omitted_paths",
    "truncated.map(item => `${item.displayPath} from ${item.originalBytes} to ${item.includedBytes} bytes`).join(', ')": "truncated_items",
    "item.displayPath": "display_path",
    "item.originalBytes": "original_bytes",
    "item.includedBytes": "included_bytes",
}


class ExtractError(Exception):
    """One extraction anchor failed to resolve against the sources."""


def read(source_root, relative):
    with open(os.path.join(source_root, relative), encoding="utf-8") as handle:
        return handle.read()


def skip_ws(text, index):
    while index < len(text) and text[index] in " \t\r\n":
        index += 1
    return index


def decode_escape(text, index):
    """Decode the escape at `text[index] == '\\'`; returns (char, next)."""
    char = text[index + 1]
    if char == "n":
        return "\n", index + 2
    if char == "t":
        return "\t", index + 2
    if char == "r":
        return "\r", index + 2
    if char == "0":
        return "\0", index + 2
    if char == "u":
        if text[index + 2] == "{":
            end = text.index("}", index + 3)
            return chr(int(text[index + 3 : end], 16)), end + 1
        return chr(int(text[index + 2 : index + 6], 16)), index + 6
    return char, index + 2


def parse_quoted(text, index):
    """Parse a quoted literal at `text[index]`; returns (value, next).

    Template literals keep `${...}` groups verbatim in the value; callers
    that need placeholders use `parse_template` instead.
    """
    quote = text[index]
    index += 1
    out = []
    while text[index] != quote:
        if text[index] == "\\":
            char, index = decode_escape(text, index)
            out.append(char)
        else:
            out.append(text[index])
            index += 1
    return "".join(out), index + 1


def eval_const(text, name, known):
    """Evaluate a `const NAME = literal (+ literal)*` declaration."""
    match = re.search(rf"(?:export )?const {re.escape(name)}\s*=", text)
    if match is None:
        raise ExtractError(f"const {name} not found")

    def operand(index):
        index = skip_ws(text, index)
        if text[index] in "'\"`":
            return parse_quoted(text, index)
        ident = re.match(r"[A-Za-z_$][A-Za-z0-9_$]*", text[index:])
        if ident is None:
            raise ExtractError(f"const {name}: unsupported operand at {text[index:index+20]!r}")
        token = ident.group(0)
        if token not in known:
            raise ExtractError(f"const {name}: unknown reference {token}")
        return known[token], index + len(token)

    value, index = operand(match.end())
    while True:
        probe = skip_ws(text, index)
        if probe < len(text) and text[probe] == "+":
            right, index = operand(probe + 1)
            value += right
        else:
            return value


def parse_template(text, index):
    """Parse a template literal into (parts, next).

    `parts` alternates static strings and `("ph", expr)` tuples in source
    order, starting with a static string.
    """
    assert text[index] == "`"
    index += 1
    parts = [""]
    while text[index] != "`":
        if text[index] == "\\":
            char, index = decode_escape(text, index)
            parts[-1] += char
        elif text[index] == "$" and text[index + 1] == "{":
            index += 2
            depth = 1
            start = index
            while depth:
                if text[index] == "{":
                    depth += 1
                elif text[index] == "}":
                    depth -= 1
                index += 1
            parts.append(("ph", text[start : index - 1].strip()))
            parts.append("")
        else:
            parts[-1] += text[index]
            index += 1
    return parts, index + 1


def template_by_anchor(text, anchor):
    """Find the template literal containing `anchor`; returns formatted."""
    index = text.find(anchor)
    if index < 0:
        raise ExtractError(f"template anchor {anchor!r} not found")
    start = text.rfind("`", 0, index)
    parts, _ = parse_template(text, start)
    out = []
    for part in parts:
        if isinstance(part, str):
            # Literal braces outside placeholders double for format! safety.
            out.append(part.replace("{", "{{").replace("}", "}}"))
        else:
            expr = part[1]
            if expr not in PLACEHOLDERS:
                raise ExtractError(f"no placeholder mapping for ${{{expr}}}")
            out.append("{" + PLACEHOLDERS[expr] + "}")
    return "".join(out)


def literal_containing(text, anchor):
    """Return the value of the quoted literal containing `anchor`.

    The anchor is only a search key; the value flows from the source, so a
    dsh edit that moves or rewords the sentence fails extraction instead of
    silently drifting.
    """
    index = text.find(anchor)
    if index < 0:
        raise ExtractError(f"literal anchor {anchor!r} not found")
    open_quote = text.rfind("'", 0, index)
    if open_quote < 0 or text.find("'", index) < 0:
        raise ExtractError(f"literal anchor {anchor!r} is not inside a quoted literal")
    value, _ = parse_quoted(text, open_quote)
    if anchor not in value:
        raise ExtractError(f"literal anchor {anchor!r} sits outside a single-quoted literal")
    return value


def parse_orders(text, name):
    """Parse an `as const` numeric orders table; preserves source order."""
    match = re.search(rf"const {name} = \{{(.*?)\}} as const", text, re.S)
    if match is None:
        raise ExtractError(f"orders table {name} not found")
    return re.findall(r"^\s*([A-Z_]+):\s*(-?\d+)\s*,", match.group(1), re.M)


def yaml_block_scalar(text, entry_id, key):
    """Extract one `key: |` block scalar from a `- id:` entry."""
    entry = re.search(rf"- id: {re.escape(entry_id)}\n", text)
    if entry is None:
        raise ExtractError(f"patch entry {entry_id} not found")
    tail = text[entry.end() :]
    nxt = re.search(r"\n    - id: ", tail)
    scope = tail if nxt is None else tail[: nxt.start() + 1]
    header = re.search(rf"^ *{re.escape(key)}: \|\n", scope, re.M)
    if header is None:
        raise ExtractError(f"{entry_id}: key {key} not found")
    lines = scope[header.end() :].split("\n")
    base = None
    kept = []
    for line in lines:
        if not line.strip():
            kept.append("")
            continue
        indent = len(line) - len(line.lstrip(" "))
        if base is None:
            base = indent
        if indent < base:
            break
        kept.append(line[base:])
    while kept and kept[-1] == "":
        kept.pop()
    return "\n".join(kept) + "\n"


def yaml_int(text, entry_id, key):
    entry = re.search(rf"- id: {re.escape(entry_id)}\n", text)
    if entry is None:
        raise ExtractError(f"patch entry {entry_id} not found")
    tail = text[entry.end() :]
    nxt = re.search(r"\n    - id: ", tail)
    scope = tail if nxt is None else tail[: nxt.start() + 1]
    match = re.search(rf"^ *{re.escape(key)}: (\d+)\s*$", scope, re.M)
    if match is None:
        raise ExtractError(f"{entry_id}: key {key} not found")
    return int(match.group(1))


def replaced_literal(text, call_anchor):
    """Return the replacement literal of one `replaceAll(x, '…')` call."""
    index = text.find(call_anchor)
    if index < 0:
        raise ExtractError(f"call anchor {call_anchor!r} not found")
    open_quote = text.find("'", index)
    value, _ = parse_quoted(text, open_quote)
    return value


def join_separator(text, call_anchor):
    """Return the separator literal of one `join('…')` call."""
    index = text.find(call_anchor)
    if index < 0:
        raise ExtractError(f"join anchor {call_anchor!r} not found")
    open_quote = text.find("'", index)
    value, _ = parse_quoted(text, open_quote)
    return value


def rust_str(value):
    out = []
    for char in value:
        if char == "\\":
            out.append("\\\\")
        elif char == '"':
            out.append('\\"')
        elif char == "\n":
            out.append("\\n")
        elif char == "\r":
            out.append("\\r")
        elif char == "\t":
            out.append("\\t")
        elif ord(char) < 0x20 or ord(char) == 0x7F:
            out.append(f"\\u{{{ord(char):x}}}")
        else:
            out.append(char)
    return '"' + "".join(out) + '"'


def const_doc(name, doc, value, template=False):
    kind = "format template" if template else "verbatim"
    short, _, provenance = doc.partition(" (dsh")
    provenance = ("dsh" + provenance).rstrip(")")
    return (
        f"/// {short}.\n///\n/// {provenance} ({kind}).\n"
        f"pub const {name}: &str = {rust_str(value)};\n"
    )


def generate(source_root):
    system_ts = read(source_root, SYSTEM_PROMPT_TS)
    render_ts = read(source_root, RENDER_TS)
    base = read(source_root, BASE_PATCH)

    # Simple verbatim constants from render.ts, evaluated in declaration
    # order so concatenated consts can reference earlier names.
    render_consts = {}
    for name in [
        "SYSTEM_REMINDER_OPEN",
        "SYSTEM_REMINDER_CLOSE",
        "AGENT_INSTRUCTIONS_INTRO",
        "REPLACEMENT_AGENT_INSTRUCTIONS_INTRO",
        "EMPTY_REPLACEMENT_AGENT_INSTRUCTIONS_INTRO",
        "COMPACT_AGENT_INSTRUCTIONS_INTRO",
        "ADDITIONAL_INSTRUCTIONS_GUIDANCE",
    ]:
        render_consts[name] = eval_const(render_ts, name, render_consts)

    # The identity sentence alone is brand-mapped (PRD 10); every other
    # value is verbatim from the source.
    identity = literal_containing(
        system_ts, "You are an AI agent powered by"
    ).replace("DeepSeek Harness", "Fly Rafter")

    persona_prefix = eval_const(system_ts, "PERSONA_PREFIX_SECTION", {})
    persona_suffix = eval_const(system_ts, "PERSONA_SUFFIX_SECTION", {})
    tool_order_rest = eval_const(system_ts, "TOOL_ORDER_REST", {})

    sections = [
        const_doc(
            "HARNESS_IDENTITY_TEXT",
            "Harness identity sentence (dsh system-prompt/src/index.ts, the"
            " `harness:identity` section; brand-mapped per PRD 10)",
            identity,
        ),
        const_doc(
            "RUNTIME_CONTEXT_SNAPSHOT_TEMPLATE",
            "Joined runtime-context snapshot text (dsh system-prompt/src/"
            "index.ts `joinContextSections`)",
            template_by_anchor(system_ts, "Current runtime context."),
            template=True,
        ),
        const_doc(
            "TOOL_ORDER_REST",
            "Reserved `toolOrder` rest marker (dsh system-prompt/src/index.ts)",
            tool_order_rest,
        ),
        const_doc(
            "PERSONA_PREFIX_SECTION",
            "Deployment persona prefix section name (dsh system-prompt/src/index.ts)",
            persona_prefix,
        ),
        const_doc(
            "PERSONA_SUFFIX_SECTION",
            "Deployment persona suffix section name (dsh system-prompt/src/index.ts)",
            persona_suffix,
        ),
        const_doc(
            "SYSTEM_REMINDER_OPEN",
            "Instruction frame open (dsh agent-instructions/src/render.ts)",
            render_consts["SYSTEM_REMINDER_OPEN"],
        ),
        const_doc(
            "SYSTEM_REMINDER_CLOSE",
            "Instruction frame close (dsh agent-instructions/src/render.ts)",
            render_consts["SYSTEM_REMINDER_CLOSE"],
        ),
        const_doc(
            "ESCAPED_SYSTEM_REMINDER_CLOSE",
            "Neutralized frame close injected into instruction content (dsh"
            " render.ts `escapeInstructionFrameBody`)",
            replaced_literal(render_ts, "replaceAll(SYSTEM_REMINDER_CLOSE, "),
        ),
        const_doc(
            "AGENT_INSTRUCTIONS_INTRO",
            "Baseline instruction intro (dsh agent-instructions/src/render.ts)",
            render_consts["AGENT_INSTRUCTIONS_INTRO"],
        ),
        const_doc(
            "REPLACEMENT_AGENT_INSTRUCTIONS_INTRO",
            "Replacement baseline intro (dsh agent-instructions/src/render.ts)",
            render_consts["REPLACEMENT_AGENT_INSTRUCTIONS_INTRO"],
        ),
        const_doc(
            "EMPTY_REPLACEMENT_AGENT_INSTRUCTIONS_INTRO",
            "Empty replacement baseline intro (dsh agent-instructions/src/render.ts)",
            render_consts["EMPTY_REPLACEMENT_AGENT_INSTRUCTIONS_INTRO"],
        ),
        const_doc(
            "COMPACT_AGENT_INSTRUCTIONS_INTRO",
            "Compact-budget intro (dsh agent-instructions/src/render.ts)",
            render_consts["COMPACT_AGENT_INSTRUCTIONS_INTRO"],
        ),
        const_doc(
            "ADDITIONAL_INSTRUCTIONS_GUIDANCE",
            "Per-section guidance sentence pair (dsh agent-instructions/src/render.ts)",
            render_consts["ADDITIONAL_INSTRUCTIONS_GUIDANCE"],
        ),
        const_doc(
            "SECTION_TEXT_TEMPLATE",
            "Baseline section body (dsh render.ts `sectionText`)",
            template_by_anchor(render_ts, "Instructions from: ${"),
            template=True,
        ),
        const_doc(
            "ADDITIONAL_HEADING_TEMPLATE",
            "Additional section heading (dsh render.ts `additionalSectionText`)",
            template_by_anchor(render_ts, "Additional instructions from: ${"),
            template=True,
        ),
        const_doc(
            "USER_GLOBAL_APPLICABILITY",
            "User-global applicability sentence (dsh render.ts `additionalSectionText`)",
            literal_containing(render_ts, "These user-global instructions apply to all work."),
        ),
        const_doc(
            "SCOPE_APPLICABILITY_TEMPLATE",
            "Scoped applicability sentence (dsh render.ts `additionalSectionText`)",
            template_by_anchor(render_ts, "These instructions apply to work under"),
            template=True,
        ),
        const_doc(
            "REMOVED_SECTION_TEMPLATE",
            "Removal section body (dsh render.ts `changedSectionText`)",
            template_by_anchor(render_ts, "Instructions removed: ${"),
            template=True,
        ),
        const_doc(
            "UPDATED_HEADING_TEMPLATE",
            "Update heading (dsh render.ts `changedSectionText`)",
            template_by_anchor(render_ts, "Updated instructions from: ${"),
            template=True,
        ),
        const_doc(
            "UPDATED_NOTICE",
            "Update notice sentence (dsh render.ts `changedSectionText`)",
            literal_containing(render_ts, "This file changed after it was loaded."),
        ),
        const_doc(
            "MARKER_OMITTED_TEMPLATE",
            "Budget marker omitted entry (dsh render.ts `markerText`)",
            template_by_anchor(render_ts, "omitted ${"),
            template=True,
        ),
        const_doc(
            "MARKER_TRUNCATED_TEMPLATE",
            "Budget marker truncated entry (dsh render.ts `markerText`)",
            template_by_anchor(render_ts, " from ${item.originalBytes}"),
            template=True,
        ),
        const_doc(
            "MARKER_TRUNCATED_LIST_TEMPLATE",
            "Budget marker truncated-entry list (dsh render.ts `markerText`)",
            template_by_anchor(render_ts, "truncated ${"),
            template=True,
        ),
        const_doc(
            "MARKER_LINE_TEMPLATE",
            "Budget marker line (dsh render.ts `markerText`)",
            template_by_anchor(render_ts, "Workspace instruction budget ${"),
            template=True,
        ),
        const_doc(
            "MARKER_PARTS_SEPARATOR",
            "Budget marker parts separator (dsh render.ts `markerText` join)",
            join_separator(render_ts, "parts.join("),
        ),
        const_doc(
            "MARKER_ITEMS_SEPARATOR",
            "Budget marker list separator (dsh render.ts `markerText` join)",
            join_separator(render_ts, "omitted.map(file => file.displayPath).join("),
        ),
        const_doc(
            "PLAN_MODE_SECTION",
            "Plan-mode section text (dsh bundle/base cordis.patch.yml"
            " plan-mode `section` block)",
            yaml_block_scalar(base, "plan-mode", "section"),
        ),
    ]

    max_bytes = yaml_int(base, "agent-instructions", "maxBytes")
    sections.append(
        "/// Instruction render byte budget (dsh bundle/base cordis.patch.yml\n"
        "/// agent-instructions `maxBytes`).\n"
        f"pub const AGENT_INSTRUCTIONS_MAX_BYTES: usize = {max_bytes};\n"
    )

    prompts_rs = HEADER + "\n\n" + "\n".join(sections)

    section_orders = parse_orders(system_ts, "SECTION_ORDERS")
    context_orders = parse_orders(system_ts, "CONTEXT_ORDERS")
    orders_rs = [
        HEADER,
        "",
        "/// Centrally allocated prompt-section orders (dsh system-prompt/src/index.ts",
        f"/// `SECTION_ORDERS`, {len(section_orders)} entries in source order).",
        "pub const SECTION_ORDERS: &[(&str, i64)] = &[",
    ]
    orders_rs += [f"    ({rust_str(name)}, {value})," for name, value in section_orders]
    orders_rs += [
        "];",
        "",
        "/// Centrally allocated runtime-context orders (dsh system-prompt/src/index.ts",
        f"/// `CONTEXT_ORDERS`, {len(context_orders)} entries in source order).",
        "pub const CONTEXT_ORDERS: &[(&str, i64)] = &[",
    ]
    orders_rs += [f"    ({rust_str(name)}, {value})," for name, value in context_orders]
    orders_rs += ["];", ""]
    return prompts_rs, "\n".join(orders_rs)


def rustfmt(text, suffix):
    """Normalize one generated file through rustfmt.

    The on-disk artifacts must be stable under `cargo fmt`, so the
    generator's canonical output IS the rustfmt-formatted text; generation
    and `--check` both compare that form.
    """
    import tempfile

    with tempfile.NamedTemporaryFile("w", suffix=suffix, delete=False, encoding="utf-8") as handle:
        handle.write(text)
        name = handle.name
    try:
        subprocess.run(
            ["rustfmt", "--edition", "2024", name],
            check=True,
        )
        with open(name, encoding="utf-8") as handle:
            return handle.read()
    finally:
        os.unlink(name)


def main():
    check_only = "--check" in sys.argv[1:]
    source_root = os.environ.get("FR_DSH_SOURCE", "").strip()
    if not source_root:
        print(
            "extract-prompts: FR_DSH_SOURCE is not set; point it at the"
            " deepseek-harness checkout (PRD 22: prompt constants are"
            " script-extracted, never hand-copied).",
            file=sys.stderr,
        )
        return 2
    prompts_rs, orders_rs = generate(source_root)
    outputs = (
        (OUT_PROMPTS, rustfmt(prompts_rs, ".rs")),
        (OUT_ORDERS, rustfmt(orders_rs, ".rs")),
    )
    if check_only:
        failed = False
        for path, want in outputs:
            have = open(path, encoding="utf-8").read() if os.path.exists(path) else ""
            if have != want:
                failed = True
                diff = list(difflib.unified_diff(have.splitlines(), want.splitlines(), "on-disk", "regenerated", lineterm=""))[:40]
                print(f"extract-prompts: {os.path.relpath(path, REPO_ROOT)} drifted:", file=sys.stderr)
                print("\n".join(diff), file=sys.stderr)
        return 1 if failed else 0
    for path, content in outputs:
        with open(path, "w", encoding="utf-8") as handle:
            handle.write(content)
        print(f"wrote {os.path.relpath(path, REPO_ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
