#!/usr/bin/env python3
"""Extract the compaction prompt constants from the dsh summarizer source.

PRD 22: every prompt constant is script-extracted from the deepseek-harness
sources; hand-copying is forbidden. Every compaction constant is verbatim.

Usage:
    FR_DSH_SOURCE=<dsh checkout> scripts/extract-compaction-prompts          # regenerate
    FR_DSH_SOURCE=<dsh checkout> scripts/extract-compaction-prompts --check  # diff only

Output:
    crates/fr-compaction/src/prompts.rs  the four constants
"""

import difflib
import os
import re
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO_ROOT, "crates", "fr-compaction", "src", "prompts.rs")

SUMMARIZER_TS = os.path.join(
    "packages", "compaction", "compaction-basic", "src", "summarizer.ts"
)

HEADER = """\
//! Generated compaction prompt constants; do not edit.
//!
//! @generated by scripts/extract-compaction-prompts from the deepseek-harness
//! summarizer source (FR_DSH_SOURCE). DO NOT EDIT: rerun
//! `FR_DSH_SOURCE=<dsh checkout> scripts/extract-compaction-prompts`.
//! Every constant is verbatim (PRD 22).

#![allow(
    clippy::doc_markdown,
    reason = "generated provenance comments quote wire names verbatim"
)]
"""


class ExtractError(Exception):
    """One extraction anchor failed to resolve against the source."""


def read(source_root, relative):
    with open(os.path.join(source_root, relative), encoding="utf-8") as handle:
        return handle.read()


def decode_escape(text, index):
    """Decode the escape at `text[index] == '\\\\'`; returns (char, next)."""
    table = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", "'": "'", '"': '"', "`": "`"}
    char = text[index + 1]
    if char not in table:
        raise ExtractError(f"unsupported escape \\{char}")
    return table[char], index + 2


def parse_quoted(text, index):
    """Parse the quoted literal at `text[index]`; returns (value, next)."""
    quote = text[index]
    index += 1
    out = []
    while text[index] != quote:
        if text[index] == "\\":
            char, index = decode_escape(text, index)
            out.append(char)
        else:
            out.append(text[index])
            index += 1
    return "".join(out), index + 1


def eval_const(text, name):
    """Evaluate a `const NAME = <literal>` declaration."""
    match = re.search(rf"(?:export )?const {re.escape(name)}\s*=\s*", text)
    if match is None:
        raise ExtractError(f"const {name} not found")
    value, _ = parse_quoted(text, match.end())
    return value


def eval_joined_array(text, name, separator):
    """Evaluate a `const NAME = [literal, ...].join(<separator>)` declaration."""
    match = re.search(rf"(?:export )?const {re.escape(name)}\s*=\s*\[", text)
    if match is None:
        raise ExtractError(f"const {name} array not found")
    index = skip_ws(text, match.end() - 1 + 1)
    parts = []
    while True:
        index = skip_ws(text, index)
        if text[index] == "]":
            index += 1
            break
        value, index = parse_quoted(text, index)
        parts.append(value)
        index = skip_ws(text, index)
        if text[index] == ",":
            index += 1
    tail = text[index : index + 40]
    if not tail.startswith(f".join({separator!r})"):
        raise ExtractError(f"const {name}: expected .join({separator!r}), found {tail[:20]!r}")
    return separator.join(parts)


def skip_ws(text, index):
    while index < len(text) and text[index] in " \t\r\n":
        index += 1
    return index


def rust_literal(value):
    """Render one value as a single-line Rust string literal body."""
    escaped = (
        value.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )
    return f'"{escaped}"'


def main():
    source_root = os.environ.get("FR_DSH_SOURCE")
    if not source_root:
        print("FR_DSH_SOURCE must name the deepseek-harness checkout", file=sys.stderr)
        return 2
    text = read(source_root, SUMMARIZER_TS)

    open_tag = eval_const(text, "SUMMARY_OPEN_TAG")
    close_tag = eval_const(text, "SUMMARY_CLOSE_TAG")
    preamble = eval_const(text, "CHECKPOINT_PREAMBLE")
    instruction = eval_joined_array(text, "COMPACTION_INSTRUCTION", "\n")
    # The last array line is a template literal interpolating the tags; the
    # dsh runtime value substitutes them (no format! face exists here).
    for name, value in (
        ("SUMMARY_OPEN_TAG", open_tag),
        ("SUMMARY_CLOSE_TAG", close_tag),
    ):
        instruction = instruction.replace("${" + name + "}", value)

    body = HEADER + "\n"
    body += "/// Tags wrapping the structured summary inside the landed checkpoint node.\n"
    body += f"pub const SUMMARY_OPEN_TAG: &str = {rust_literal(open_tag)};\n"
    body += "\n"
    body += "/// The closing tag paired with [`SUMMARY_OPEN_TAG`].\n"
    body += f"pub const SUMMARY_CLOSE_TAG: &str = {rust_literal(close_tag)};\n"
    body += "\n"
    body += "/// Framing that makes the replacement user message established context.\n"
    body += f"pub const CHECKPOINT_PREAMBLE: &str = {rust_literal(preamble)};\n"
    body += "\n"
    body += "/// The summarization directive, delivered as the FINAL user message.\n"
    body += "///\n"
    body += "/// It rides after the replayed conversation rather than a distinct\n"
    body += "/// summarizer system prompt. Keeping the conversation's own system prompt,\n"
    body += "/// tools, and message\n"
    body += "/// prefix in front of it makes the auxiliary call a genuine prefix of the\n"
    body += "/// last routed request, so the provider's KV cache is reused instead of\n"
    body += "/// invalidated.\n"
    body += f"pub const COMPACTION_INSTRUCTION: &str = {rust_literal(instruction)};\n"

    if "--check" in sys.argv[1:]:
        with open(OUT, encoding="utf-8") as handle:
            current = handle.read()
        if current != body:
            diff = difflib.unified_diff(
                current.splitlines(keepends=True),
                body.splitlines(keepends=True),
                fromfile=OUT,
                tofile=f"{OUT} (regenerated)",
            )
            sys.stdout.writelines(diff)
            print("compaction prompts are stale; rerun the extractor", file=sys.stderr)
            return 1
        print("compaction prompts are up to date")
        return 0

    with open(OUT, "w", encoding="utf-8") as handle:
        handle.write(body)
    print(f"wrote {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
